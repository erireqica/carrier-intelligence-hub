APP_NAME=Carrier Intelligence API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5433/carrier_intelligence_hub
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5433/carrier_intelligence_hub_test
DEMO_SEED_PASSWORD=choose-a-local-development-password
SESSION_COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_INITIAL_LOOKBACK_DAYS=7
